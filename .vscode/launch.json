{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Revised nested project validation",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run_nested_validation.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Legacy exploratory smoke run",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run_all.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "args": [
        "--config", "configs/smoke.yaml",
        "--skip-shap",
        "--skip-benchmark",
        "--skip-sensitivity"
      ]
    },
    {
      "name": "Legacy exploratory training",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run_train.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "args": ["--config", "configs/default.yaml"]
    }
  ]
}
